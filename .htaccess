<IfModule mod_rewrite.c>
    RewriteEngine On

    # Do not rewrite if already pointing to public
    RewriteRule ^public/ - [L]

    # Rewrite all incoming requests to the public directory
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Disable directory browsing
Options -Indexes

# Block sensitive files from direct web access
<FilesMatch "(\.(sql|md|log|ini)|config\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

