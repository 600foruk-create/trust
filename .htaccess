<IfModule mod_rewrite.c>
    RewriteEngine On

    # Fix mistaken /dashboard.php/filename.php URLs
    RewriteRule ^dashboard\.php/print_voucher\.php(.*)$ print_voucher.php$1 [R=301,L,QSA]
    RewriteRule ^dashboard\.php/donate\.php(.*)$ donate.php$1 [R=301,L,QSA]
    RewriteRule ^public/dashboard\.php/print_voucher\.php(.*)$ public/print_voucher.php$1 [R=301,L,QSA]
    RewriteRule ^public/dashboard\.php/donate\.php(.*)$ public/donate.php$1 [R=301,L,QSA]

    # Do not rewrite if already pointing to public
    RewriteRule ^public/ - [L]

    # Rewrite all incoming requests to the public directory
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Disable directory browsing
Options -Indexes

# Block sensitive files from direct web access
<FilesMatch "(\.(sql|md|log|ini)|config\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

